{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git pull --ff-only)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Edit(docs/product/**)"
    ],
    "ask": [
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.config/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.codex/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Bash(gh * -R*)",
      "Bash(gh * --repo*)",
      "Bash(gh -R*)",
      "Bash(gh --repo*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(gh label *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh ruleset *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git reset --hard *)",
      "Bash(git * --upload-pack*)",
      "Bash(git * --no-index*)",
      "Bash(git * --output*)",
      "Edit(.github/**)",
      "Edit(AGENTS.md)",
      "Edit(PRODUCT_AGENT.md)"
    ]
  }
}
